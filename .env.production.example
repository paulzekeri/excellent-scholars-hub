APP_NAME="Excellent Scholars Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://eshglobal.org

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpuser_esh_live
DB_USERNAME=cpuser_esh_live
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Replace with the real mailbox once email is needed (password reset is disabled in
# routes/web.php, so the app currently sends nothing).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@lit-grp.com"
MAIL_FROM_NAME="${APP_NAME}"

# Internal assessment notifications (comma-separated for several addresses)
ASSESSMENT_NOTIFY_TO=excellentscholars2@gmail.com
ASSESSMENT_NOTIFY_CC=admin@eshglobal.org,ceo@eshglobal.org

# Never seed demo accounts in production. Create the first real login with:
#   php artisan esh:create-admin --role=ceo
SEED_DEMO_ACCOUNTS=false

# Web Push (phone notifications) - generate a pair with: php artisan push:keys
WEBPUSH_ENABLED=true
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=


# Hidden maintenance account (optional). When both are set, the seeder that every
# deploy runs creates it once - it is never listed, messaged or emailed.
# Never commit real credentials. See MAINTENANCE-USER.md.
SUPER_ADMIN_NAME="Maintenance"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
