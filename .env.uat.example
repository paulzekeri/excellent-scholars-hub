# Template for the UAT server (https://uat.eshglobal.org, deployed from the `uat`
# branch by .github/workflows/deploy-cpanel-uat.yml). Production
# (https://eshglobal.org) uses .env.production.example.
APP_NAME="Excellent Scholars Hub (UAT)"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://uat.eshglobal.org

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpuser_esh_uat
DB_USERNAME=cpuser_esh_uat
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# No mail is sent by the app (password reset is disabled, notifications are in-app).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@lit-grp.com"
MAIL_FROM_NAME="${APP_NAME}"

# Internal assessment notifications (comma-separated for several addresses)
ASSESSMENT_NOTIFY_TO=excellentscholars2@gmail.com
ASSESSMENT_NOTIFY_CC=admin@eshglobal.org,ceo@eshglobal.org

# Testing only: create the demo logins (ceo@esh.com, admin@esh.com, tutor@esh.com,
# learner@esh.com, parent@esh.com - all with password "password").
SEED_DEMO_ACCOUNTS=true

# Free learning-goal wording assistant (LanguageTool) - no key needed.
GOAL_WORDING_ASSISTANT=true
LANGUAGETOOL_URL=https://api.languagetool.org/v2/check
LANGUAGETOOL_LANGUAGE=en-US

# Web Push (phone notifications) - generate a pair with: php artisan push:keys
WEBPUSH_ENABLED=true
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=


# Hidden maintenance account (optional). When both are set, the seeder that every
# deploy runs creates it once - it is never listed, messaged or emailed.
# Never commit real credentials. See MAINTENANCE-USER.md.
SUPER_ADMIN_NAME="Maintenance"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
