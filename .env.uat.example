APP_NAME="ESH LMS (UAT)"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://uat-esh.lit-grp.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpuser_esh_uat
DB_USERNAME=cpuser_esh_uat
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# No mail is sent by the app (password reset is disabled, notifications are in-app).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@lit-grp.com"
MAIL_FROM_NAME="${APP_NAME}"

# UAT only: create the demo logins (ceo@esh.com, admin@esh.com, tutor@esh.com,
# learner@esh.com, parent@esh.com - all with password "password").
SEED_DEMO_ACCOUNTS=true
