# =====================================================================
# ESH LMS - cPanel front controller
# ---------------------------------------------------------------------
# The cPanel document root for eshglobal.org is a normal folder
# (/home/eshgloba/public_html; a subdomain such as uat.eshglobal.org lives in
# /home/eshgloba/public_html/uat.eshglobal.org) that receives the whole Laravel
# application, because changing the document root to public/ is not always
# possible. This file therefore lives in that folder and forwards every
# request into public/, so app/, config/, database/, storage/, vendor/ and
# .env are never reachable from a URL.
#
# Local development is unaffected: "php artisan serve" does not read this
# file, and XAMPP still serves the app from public/ when you open
# http://localhost/excellent-scholars-hub/public/.
# =====================================================================

# =====================================================================
# PHP version for this domain (cPanel)
# ---------------------------------------------------------------------
# cPanel applies a domain's MultiPHP selection by writing a handler block
# into the document root's .htaccess. This repository ships its own
# .htaccess and the deploy overwrites the server copy, which erased that
# block: Apache then fell back to the account default (PHP 8.1) and
# Laravel 13 refused to boot with
#   "Your Composer dependencies require a PHP version >= 8.3.0".
#
# Pinning it here means a deploy SETS the version instead of erasing it.
# The block only applies when the server runs LiteSpeed/LSAPI, so XAMPP
# (which has no such module) is completely unaffected. It is a no-op on a
# PHP-FPM domain, where cPanel keeps the version in the vhost instead.
# =====================================================================

# php -- BEGIN cPanel-generated handler, do not edit
# Uses the same form cPanel writes for this account's other domains
# (application/x-httpd-ea-php81 ...). SmartWeb's LiteSpeed honours the PLAIN
# handler name; the "…___lsphp" variant is unknown there and silently falls
# back to the account default PHP. Keep this line identical in form.
AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
# php -- END cPanel-generated handler, do not edit

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Leave requests that already resolve into public/ alone (prevents loops
    # and keeps the /public/storage symlink working).
    RewriteRule ^public/ - [L]

    # Never intercept domain/SSL validation requests (AutoSSL, Let's Encrypt).
    RewriteCond %{REQUEST_URI} !^/\.well-known/

    # Everything else is handled by Laravel's front controller.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Do not expose directory listings.
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Belt-and-braces: refuse direct HTTP access to sensitive files. This only
# matters because the application is deployed inside the document root.
<FilesMatch "(^\.env|^composer\.(json|lock)$|^package(-lock)?\.json$|^webpack\.mix\.js$|^server\.php$|^phpunit\.xml(\.dist)?$|^artisan$|^\.user\.ini$|^\.editorconfig$|\.(log|sql|bak|old|ini|yml|yaml|lock|sh|md|ps1)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
