APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Password-reset emails go through this mailer. On a server without mail use "log";
# administrators can then generate a one-time reset link from Admin -> Users -> Reset password.
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# Internal assessment notifications (comma-separated for several addresses)
ASSESSMENT_NOTIFY_TO=excellentscholars2@gmail.com
ASSESSMENT_NOTIFY_CC=admin@eshglobal.org,ceo@eshglobal.org

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Card payments (optional, future): the parent form keeps cards as "coming soon"
# until both keys are present. See App\Services\PaystackService.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# Free learning-goal wording assistant (LanguageTool). No account or API key is
# needed for the public endpoint. Set GOAL_WORDING_ASSISTANT=false to hide the
# button, or point LANGUAGETOOL_URL at a self-hosted instance.
GOAL_WORDING_ASSISTANT=true
LANGUAGETOOL_URL=https://api.languagetool.org/v2/check
LANGUAGETOOL_LANGUAGE=en-US
LANGUAGETOOL_TIMEOUT=15

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"


# Web Push (phone notifications) - generate a pair with: php artisan push:keys
WEBPUSH_ENABLED=true
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=


# Hidden maintenance account (optional). When both are set, the seeder that every
# deploy runs creates it once - it is never listed, messaged or emailed.
# Never commit real credentials. See MAINTENANCE-USER.md.
SUPER_ADMIN_NAME="Maintenance"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
